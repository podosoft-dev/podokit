{
  "name": "@podosoft/podokit-runtime",
  "version": "0.2.0",
  "description": "Provider-neutral runtime contracts and local providers for PodoKit applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/podosoft-dev/podokit.git",
    "directory": "packages/runtime"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
