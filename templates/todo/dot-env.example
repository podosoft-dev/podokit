# Copy to .env and adjust. Never commit real secrets.

# ── Required (runtime) ───────────────────────────────────────────────
NODE_ENV=development
PORT=5002

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=podokit
POSTGRES_PASSWORD=podokit
POSTGRES_DB=podokit

# Web -> API boundary (server-side only; not exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:5002

# Exact paths the web server may proxy as WebSocket upgrades to the API, comma
# separated. Empty means none: a SvelteKit route cannot answer an upgrade, so a
# WebSocket gateway on the API is unreachable until it is named here. Each path is
# matched whole and must be authorised by the API at handshake time -- a relay that
# forwards anything is an open tunnel to every private route.
WS_PROXY_PATHS=
CORS_ORIGIN=http://localhost:5001

# ── Optional / development ───────────────────────────────────────────
# Redis — only needed by cache/queue modules. Start it with:
# docker compose --profile cache up
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL takes precedence over the individual settings below.
# REDIS_URL=rediss://user:password@cache.example.com:6380/0
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_TLS=false
