# Development image for the PodoKit monorepo (web + api).
# Dependencies and source are baked in; `docker compose watch` syncs your
# edits into the running container so the native file watchers fire.

# Every workspace manifest, collected rather than listed.
#
# Listing them by hand only works for the workspaces this template starts with. A
# project that adds `packages/*` then has workspace manifests that never reach the
# image, so npm does not know those names are local and goes looking for them on the
# public registry — `npm error 404 '@scope/thing' is not in this registry`, from an
# install that succeeds on the developer's own machine. The production images
# collect manifests for exactly this reason; this one was the exception until a
# generated project with shared packages could not start its dev stack at all.
FROM node:22-bookworm-slim AS manifests
WORKDIR /src
COPY . .
RUN mkdir -p /app \
    && cp package.json /app/ \
    && find . -name package.json -not -path "*/node_modules/*" \
         -exec sh -c 'mkdir -p "/app/$(dirname "$1")" && cp "$1" "/app/$1"' _ {} \;

FROM node:22-bookworm-slim

# git for the toolchain (editors, AI agents); build tools for native modules.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install workspace dependencies (cached unless a package.json changes).
# NB: the host package-lock.json is intentionally NOT copied — a lockfile
# generated on macOS/Windows prunes platform-specific optional deps and can drop
# packages (e.g. @swc/cli) on linux. Resolving fresh in-container avoids that.
COPY --from=manifests /app ./
ARG PODOKIT_NPM_REGISTRY=""
RUN if [ -n "$PODOKIT_NPM_REGISTRY" ]; then npm config set registry "$PODOKIT_NPM_REGISTRY"; fi \
  && npm install

# Baked source (kept in sync during development by `docker compose watch`).
COPY . .

# Workspace packages compile before the apps that import them. Apps import them by
# their published entry point (`dist/index.js`), so without this the API starts and
# dies on MODULE_NOT_FOUND for a package whose symlink is right there — the link
# resolves, the built file behind it does not exist. `--if-present` keeps a project
# with no packages, or one whose packages need no build, working unchanged.
#
# `docker compose watch` syncs app source only, so a change under packages/* needs
# this image rebuilt rather than a container restart.
RUN if [ -d packages ]; then \
      for manifest in packages/*/package.json; do \
        [ -e "$manifest" ] || continue; \
        npm run build --if-present --workspace "$(dirname "$manifest")"; \
      done; \
    fi

EXPOSE 5001 5002
