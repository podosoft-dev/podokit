{
  "name": "{{projectName}}",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "workspaces": [
    "apps/*",
    "tests"
  ],
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    },
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  },
  "trustedDependencies": [
    "@swc/core"
  ],
  "scripts": {
    "dev": "bun run --workspaces --if-present dev",
    "build": "bun run --workspaces --if-present build",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun run --workspaces --if-present test",
    "test:e2e": "bun run --cwd tests test:e2e",
    "test:e2e:ui": "bun run --cwd tests test:e2e:ui",
    "test:e2e:api": "bun run --cwd tests test:e2e:api"
  }
}
