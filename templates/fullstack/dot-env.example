# Copy to .env and adjust. Never commit real secrets.

# ── Required (runtime) ───────────────────────────────────────────────
NODE_ENV=development
PORT=5002

# Canonical database connection. Set this for PostgreSQL or SQLite; POSTGRES_* remains a fallback.
# DATABASE_URL=postgres://podokit:podokit@localhost:5432/podokit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=podokit
POSTGRES_PASSWORD=podokit
POSTGRES_DB=podokit

# PostgreSQL pools. Each API replica opens up to DB_POOL_MAX connections for
# queries, plus DB_AUTH_POOL_MAX for the auth module when it is installed. Keep
# replicas x (DB_POOL_MAX + DB_AUTH_POOL_MAX), plus a few for migrations, below
# the server's max_connections (100 by default). The timeouts are milliseconds.
# DB_POOL_MAX=20
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# DB_AUTH_POOL_MAX=10

# Readiness (GET /health/ready): the longest one dependency check may run, and how
# long a result is reused across probes (0 checks on every request).
# READINESS_CHECK_TIMEOUT_MS=800
# READINESS_CACHE_MS=2000

# Web -> API boundary (server-side only; not exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:5002

CORS_ORIGIN=http://localhost:5001
# Web request limit; leave room for a 2 MiB multipart upload
BODY_SIZE_LIMIT=3M

# ── Optional / development ───────────────────────────────────────────
# Redis — only needed by cache/queue modules (redis, bullmq, rate-limit,
# job-progress, sse). Start it with: docker compose --profile cache up
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL takes precedence over the individual settings below.
# REDIS_URL=rediss://user:password@cache.example.com:6380/0
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_TLS=false
