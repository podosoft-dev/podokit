{
  "name": "{{projectName}}",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "echo \"Run 'dev' in apps/api and apps/web\" && exit 0",
    "build": "bun run --workspaces --if-present build",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun run --workspaces --if-present test"
  }
}
